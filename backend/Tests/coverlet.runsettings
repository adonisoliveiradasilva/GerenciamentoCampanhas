<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <ExcludeByFile>**/Migrations/**,**/obj/**</ExcludeByFile>
          <Exclude>[Api]Program,[Api]Microsoft.AspNetCore.OpenApi.Generated.*,[Api]System.Runtime.CompilerServices.*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
